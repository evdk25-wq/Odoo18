<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opportunity_kanban" model="ir.ui.view">
        <field name="name">mini.crm.opportunity.kanban</field>
        <field name="model">mini.crm.opportunity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_small_column" records_draggable="1">
                <field name="stage"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <strong class="text-truncate">
                                <field name="name"/>
                            </strong>
                            <span class="text-muted">
                                <field name="partner_id"/>
                            </span>
                            <div class="mt-2 text-end font-weight-bold">
                                <field name="expected_revenue"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_opportunity_list" model="ir.ui.view">
        <field name="name">mini.crm.opportunity.list</field>
        <field name="model">mini.crm.opportunity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="expected_revenue"/>
                <field name="stage"/>
            </list>
        </field>
    </record>

    <record id="view_opportunity_form" model="ir.ui.view">
        <field name="name">mini.crm.opportunity.form</field>
        <field name="model">mini.crm.opportunity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="expected_revenue"/>
                        <field name="stage"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_opportunity" model="ir.actions.act_window">
        <field name="name">Opportunities</field>
        <field name="res_model">mini.crm.opportunity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_opportunity_kanban"/>
    </record>

    <menuitem
        id="menu_mini_crm_root"
        name="Mini CRM"
        sequence="10"/>

    <menuitem
        id="menu_mini_crm_opportunities"
        name="Opportunities"
        parent="menu_mini_crm_root"
        action="action_opportunity"
        sequence="10"/>

    </odoo>
