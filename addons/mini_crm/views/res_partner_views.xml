<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_priority" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.priority</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_set_priority"
                            string="Marquer Prioritaire"
                            type="object"
                            class="btn-primary"/>
                    </header>
                </xpath>

                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="is_priority_customer"/>
                </xpath>

            </field>
        </record>

    </odoo>
